#include <linux/bpf.h>
#include <linux/if_ether.h>
#include <linux/ip.h>
#include <linux/udp.h>
#include <bpf/bpf_helpers.h>

struct {
    __uint(type, BPF_MAP_TYPE_RINGBUF);
    __uint(max_entries, 1 << 22); // 4MB Ring Buffer
} rx_ringbuf SEC(".maps");

SEC("xdp")
int xdp_packet_handler(struct xdp_md *ctx) {
    void *data_end = (void *)(long)ctx->data_end;
    void *data     = (void *)(long)ctx->data;

    // Layer 2: Ethernet Header Verification
    struct ethhdr *eth = data;
    if ((void *)(eth + 1) > data_end)
        return XDP_PASS;

    if (eth->h_proto != __constant_htons(ETH_P_IP))
        return XDP_PASS;

    // Layer 3: IPv4 Header Verification
    struct iphdr *ip = (void *)(eth + 1);
    if ((void *)(ip + 1) > data_end)
        return XDP_PASS;

    if (ip->protocol != IPPROTO_UDP)
        return XDP_PASS;

    // Layer 4: UDP Header Verification
    struct udphdr *udp = (void *)(ip + 1);
    if ((void *)(udp + 1) > data_end)
        return XDP_PASS;

    // Filter target port 12345 (0x3039)
    if (udp->dest != __constant_htons(12345))
        return XDP_PASS;

    // Calculate payload bounds
    void *payload = (void *)(udp + 1);
    __u32 payload_len = __constant_ntohs(udp->len) - sizeof(struct udphdr);
    
    if (payload + payload_len > data_end)
        return XDP_PASS;

    // Allocate space inside the zero-lock ring buffer
    void *ringbuf_space = bpf_ringbuf_reserve(&rx_ringbuf, payload_len, 0);
    if (!ringbuf_space) {
        return XDP_DROP; // Drop packet to prevent saturation if buffer is full
    }

    // Direct memory copy to ring buffer space
    __builtin_memcpy(ringbuf_space, payload, payload_len);

    // Commit packet data directly to user space
    bpf_ringbuf_submit(ringbuf_space, 0);

    // Completely drop packet out of standard Linux networking stack traversal
    return XDP_DROP;
}

